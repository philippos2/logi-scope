# Copy to .env and replace this dummy password. Never commit .env.
POSTGRES_ADMIN_PASSWORD=replace-with-local-password
POSTGRES_READER_PASSWORD=replace-with-different-reader-password
POSTGRES_INGEST_PASSWORD=replace-with-different-ingest-password

# Match the WSL user's `id -u` and `id -g` (not the Docker group).
LOCAL_UID=1000
LOCAL_GID=1000

# Default for Ollama on the host. Adjust for the actual server location/port.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=logiscope-qwen30-probe
LLM_REQUEST_TIMEOUT=300

# Set LLM_REASONING_EFFORT=omit to omit the reasoning_effort parameter for servers that do not support it.
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=1200
AGENT_MAX_LLM_CALLS=8
AGENT_MAX_TOOL_ATTEMPTS=12
AGENT_TOTAL_TIMEOUT=900
